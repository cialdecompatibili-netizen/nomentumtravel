[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<style>.nt{--ink:#16222b;--sea:#1f6f8b;--sand:#f5f1ea;--mut:#53606a;--line:#ddd6c9;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--ink)}.nt *{box-sizing:border-box}.nt-w{max-width:1100px;margin:0 auto;padding:0 1.5rem}.nt-sec{padding:clamp(2.5rem,6vw,4.5rem) 0}.nt-sand{background:var(--sand)}.nt-eb{font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;color:var(--sea);font-weight:700;margin:0 0 .8rem}.nt h1{font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.08;margin:0 0 1rem;text-wrap:balance}.nt h2{font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.15;margin:0 0 .7rem}.nt-lead{font-size:1.1rem;line-height:1.65;color:var(--mut);max-width:60ch;margin:0 0 1.6rem}.nt-btn{display:inline-block;padding:.85rem 1.6rem;background:var(--sea);color:#fff!important;font-weight:700;text-decoration:none;border-radius:6px;margin:0 .6rem .6rem 0}.nt-btn.o{background:transparent;color:var(--ink)!important;border:1px solid var(--ink)}.nt-g{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-top:1.8rem}.nt-g4{grid-template-columns:repeat(4,1fr)}.nt-c{background:#fff;border:1px solid var(--line);padding:1.4rem;border-radius:8px}.nt-sand .nt-c{background:#fff}.nt-c h3{margin:0 0 .5rem;font-size:1.2rem}.nt-c p{margin:0;color:var(--mut);line-height:1.55;font-size:.97rem}.nt-c a{display:inline-block;margin-top:.8rem;font-weight:700;color:var(--sea)}@media(max-width:860px){.nt-g,.nt-g4{grid-template-columns:1fr}}</style><div class=\"nt\"><section class=\"nt-sec nt-sand\"><div class=\"nt-w\"><p class=\"nt-eb\">Mentana &middot; 25 km from Rome</p><h1>Stay near Rome. Reach everything in a day.</h1><p class=\"nt-lead\">Rome, the mountains and the sea are all within a day trip from Mentana. Sleep in a quiet town, leave in the morning, come back to a calm evening.</p><a class=\"nt-btn\" href=\"#trips\">See the trips</a><a class=\"nt-btn o\" href=\"__BASEURL__/contatti/\">Ask for a quote</a></div></section></div>"
  },
  {
    "id": "trips",
    "nome": "Trips",
    "enabled": true,
    "html": "<div class=\"nt\"><section class=\"nt-sec\" id=\"trips\"><div class=\"nt-w\"><p class=\"nt-eb\">Day trips and tours</p><h2>Three directions, one base</h2><p class=\"nt-lead\">Every trip starts and ends near Mentana. Itineraries, prices and dates are being finalised.</p><div class=\"nt-g\"><div class=\"nt-c\"><h3>Rome</h3><p>Classic sights, quiet neighbourhoods, early-morning or evening visits away from the crowds.</p></div><div class=\"nt-c\"><h3>Mountains</h3><p>Snow in winter (Terminillo, Abruzzo), fresh air and villages in summer.</p></div><div class=\"nt-c\"><h3>Sea</h3><p>Roman coast, Circeo, Sperlonga, Gaeta: beach days from late spring to early autumn.</p></div></div></div></section></div>"
  },
  {
    "id": "seasons",
    "nome": "Seasons",
    "enabled": true,
    "html": "<div class=\"nt\"><section class=\"nt-sec nt-sand\"><div class=\"nt-w\"><p class=\"nt-eb\">When to come</p><h2>Something for every season</h2><div class=\"nt-g nt-g4\"><div class=\"nt-c\"><h3>Winter</h3><p>Quieter Rome, snow in the mountains.</p></div><div class=\"nt-c\"><h3>Spring</h3><p>Rome, hill towns and lakes with fewer crowds.</p></div><div class=\"nt-c\"><h3>Summer</h3><p>Sea days, cool mountains, Rome early or late.</p></div><div class=\"nt-c\"><h3>Autumn</h3><p>Lower prices, food and wine, villages.</p></div></div></div></section></div>"
  },
  {
    "id": "network",
    "nome": "Dal network Nomentum",
    "enabled": true,
    "html": "<div class=\"nt\"><section class=\"nt-sec\"><div class=\"nt-w\"><p class=\"nt-eb\">From the Nomentum network</p><h2>Sleep, travel, settle</h2><div class=\"nt-g\"><div class=\"nt-c\"><h3>Villa Nomentum</h3><p>Rooms and stays in a quiet villa in Mentana: the best base for these trips.</p><a href=\"https://cialdecompatibili-netizen.github.io/villanomentum/\">See the villa</a></div><div class=\"nt-c\"><h3>Nomentum Viaggi</h3><p>Bus tours, weekends, snow and sea trips, in Italian.</p><a href=\"https://cialdecompatibili-netizen.github.io/nomentumviaggi/\">Vai al sito</a></div><div class=\"nt-c\"><h3>Immobiliare Nomentum</h3><p>Thinking of moving to the area? Homes for sale and rent.</p><a href=\"https://cialdecompatibili-netizen.github.io/immobiliarenomentum/\">Vai al sito</a></div></div></div></section></div>"
  },
  {
    "id": "contatti",
    "nome": "Contatti",
    "enabled": true,
    "html": "<div class=\"nt\"><section class=\"nt-sec nt-sand\"><div class=\"nt-w\"><h2>Plan your stay</h2><p class=\"nt-lead\">Tell us when you come and what you want to see: one request covers stay and trips.</p><a class=\"nt-btn\" href=\"__BASEURL__/contatti/\">Send a request</a></div></section></div>"
  }
]
